 * Optimizely JS — Standalone "Small business?" notification banner
 * Page: https://www.salesforce.com/au/?forceprofile=prospect
 */
(function () {
  'use strict';

  // --- CONTENT -------------------------------------------------------------
  var CONTENT = {
    badgeText: 'Small business?',
    // HTML allowed. <br> only shows on large screens (see CSS).
    headlineHtml:
      'Get started for free with the&nbsp;#1 Agentic CRM ' +
      '<br><strong>Nothing to install, no credit card required.</strong>',
    primaryText: 'Start for free',
    primaryUrl:
      'https://www.salesforce.com/ap/small-business/free-trial/starter-suite-v2/?d=pb',
    secondaryText: 'Watch demo',
    secondaryUrl:
      'https://www.salesforce.com/ap/small-business/demos/smb-overview/?d=pb',
    showArrowIcons: true,
    // If true, try to inherit the page's live CTA hrefs (by matching link text
    // / data-name) and use them instead of the URLs above.
    inheritLiveLinks: true
  };

  // --- MOUNT: where the band is inserted -----------------------------------

  var MOUNT = {
    targets: [
      { selector: '.relative.overflow-hidden.direction-2-background', position: 'prepend' }
    ]
  };

  // --- REMOVE: hide the original hero <section> ----------------------------

  var REMOVE = {
    enabled: true,
    // A section matches if its class contains ANY of these substrings...
    classContains: ['from-[#00B3FF]'],
    // ...OR it contains a CTA with one of these data-name values.
    ctaDataNames: ['Start for free', 'Watch demo']
  };

  // --- REQUIRE_BLADE: only render on the prospect homepage -----------------
  // The banner only renders when a blade matching ANY of these selectors is
  // present. This blade exists on the PROSPECT homepage but not the customer
  // version, so it scopes the banner to prospects. If the blade is absent — or
  // disappears on a re-render — the banner is removed again.
  // (ids starting with a digit can't be a '#id' selector, so we match the
  // [data-blade-id] attribute.)
  var REQUIRE_BLADE = {
    enabled: true,
    selectors: ['[data-blade-id="1780430509646_1ayk"]']
  };

  // --- THEME ---------------------------------------------------------------
  var THEME = {
    // Matches the original hero's Tailwind gradient:
    // bg-gradient-to-b from-[#00B3FF] from-[18.78%] to-[#90D0FE]
    // ('to bottom', light-blue #00B3FF at 18.78% -> pale-blue #90D0FE).
    // Use 'transparent' for no band background.
    //bandGradient: 'linear-gradient(to bottom, #00B3FF 18.78%, #90D0FE)',
    bandPadding: '24px 16px',          // space around the card inside the band
    cardBg: '#E8F3FE',                 // light card background
    badgeBg: '#022AC0',
    headlinePrimary: '#022AC0',
    headlineSecondary: '#032D60',
    primaryBtnBg: '#0176D3',
    primaryBtnBgHover: '#014486',
    secondaryBtnText: '#0176D3'
  };

  // --- ANALYTICS -----------------------------------------------------------
  // Our injected CTAs aren't Page Builder markup, so the site's GTM "GA4 -
  // Content Click" tag never fires for them. On click we push the same event
  // to window.dataLayer ourselves. The field schema below mirrors the original
  // CTA's GA4 Content Click payload (from the debug log); GTM still fills the
  // page-level dimensions (locale, region, sf_page_name …) from its own
  // variables. VERIFY in GTM Preview / GA4 DebugView and tweak `eventName`/
  // fields if your container expects different keys.
  var ANALYTICS = {
    enabled: true,
    eventName: 'custEv_contentClick',  // GTM Custom Event trigger name
    blade: {
      blade_id: '',                    // optional; set to mirror a blade id
      blade_name: 'text-banner-link1',
      blade_source: 'www',
      blade_state: 'rendered',
      blade_type: 'blade',
      blade_variant: 'sf/q2-homepage'
    }
  };

  // Set false to silence console logs.
  var DEBUG = true;
  function log() {
    if (!DEBUG || !window.console) return;
    console.log.apply(console, ['[smb-banner]'].concat([].slice.call(arguments)));
  }

  var BAND_ID = 'smb-banner-band';
  var STYLE_ID = 'smb-banner-style';

  var ARROW_SVG =
    '<span class="smb-btn-icon" aria-hidden="true">' +
    '<svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" fill="currentColor">' +
    '<path fill-rule="evenodd" clip-rule="evenodd" d="M10.0977 2.16345H14.5237L6.8804 9.80671C6.69002 9.99709 6.69002 10.3058 6.8804 10.4961L7.34002 10.9558C7.5304 11.1461 7.83906 11.1461 8.02945 10.9558L15.6717 3.31348V7.73848C15.6717 8.00772 15.89 8.22598 16.1592 8.22598H16.8092C17.0785 8.22598 17.2967 8.00772 17.2967 7.73848V1.47595C17.2967 0.958186 16.877 0.538452 16.3592 0.538452H10.0977C9.82847 0.538452 9.61021 0.756713 9.61021 1.02595V1.67595C9.61021 1.94519 9.82847 2.16345 10.0977 2.16345ZM2.97559 4.03905C1.62939 4.03905 0.538086 5.13036 0.538086 6.47655V14.8516C0.538086 16.1977 1.62939 17.2891 2.97559 17.2891H11.3506C12.6968 17.2891 13.7881 16.1977 13.7881 14.8516L13.7881 8.88513C13.7881 8.59574 13.4383 8.45066 13.2335 8.65509L12.4493 9.43768C12.2661 9.62059 12.1631 9.86888 12.1631 10.1278V14.8516C12.1631 15.3003 11.7993 15.6641 11.3506 15.6641H2.97559C2.52686 15.6641 2.16309 15.3003 2.16309 14.8516V6.47655C2.16309 6.02782 2.52685 5.66405 2.97559 5.66405H7.79909C8.07127 5.66405 8.33106 5.55029 8.51564 5.35026L9.2223 4.58446C9.41442 4.37626 9.26675 4.03905 8.98345 4.03905H2.97559Z"></path>' +
    '</svg></span>';

  // --- helpers -------------------------------------------------------------
  function escapeText(str) {
    return String(str == null ? '' : str)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function escapeAttr(str) { return escapeText(str).replace(/'/g, '&#39;'); }

  // Inherit a live CTA href by matching visible link text / data-name.
  function liveHref(text) {
    if (!CONTENT.inheritLiveLinks) return null;
    var links = document.querySelectorAll('a[href]');
    for (var i = 0; i < links.length; i++) {
      var label = (links[i].getAttribute('data-name') || links[i].textContent || '').trim();
      if (label.toLowerCase() === text.toLowerCase()) {
        var href = links[i].getAttribute('href');
        if (href && href !== '#') return href;
      }
    }
    return null;
  }

  // Push the site's GA4 "Content Click" event to dataLayer for our CTAs.
  // linkType is 'primary cta' | 'secondary cta' (mirrors module_link_type).
  function trackClick(linkType, text, url) {
    if (!ANALYTICS.enabled) return;
    try {
      window.dataLayer = window.dataLayer || [];
      var payload = {
        event: ANALYTICS.eventName,
        dl_event: ANALYTICS.eventName,
        click_text: text,
        click_url: url,
        module_link_type: linkType,
        module_type: 'cta',
        destination_type: 'internal',
        content_category: 'module',
        internal_link_click: 1,
        module_clicks: 1,
        cta_clicks: 0,
        blade_module_name: text
      };
      var b = ANALYTICS.blade || {};
      for (var key in b) {
        if (b.hasOwnProperty(key) && b[key] !== '') payload[key] = b[key];
      }
      if (b.blade_id) payload.module_id = b.blade_id;
      window.dataLayer.push(payload);
      log('analytics: pushed', ANALYTICS.eventName, '|', linkType, '|', text);
    } catch (e) {
      log('analytics push failed', e);
    }
  }

  // --- markup --------------------------------------------------------------
  function ctaHtml(extraClass, href, text) {
    return '<a class="smb-btn ' + extraClass + '" href="' + escapeAttr(href) + '" ' +
      'target="_blank" rel="noopener noreferrer">' + escapeText(text) +
      (CONTENT.showArrowIcons ? ARROW_SVG : '') + '</a>';
  }

  function buildBand() {
    var primaryUrl = liveHref(CONTENT.primaryText) || CONTENT.primaryUrl;
    var secondaryUrl = liveHref(CONTENT.secondaryText) || CONTENT.secondaryUrl;

    var band = document.createElement('div');
    band.id = BAND_ID;
    band.innerHTML =
      '<div class="smb-card">' +
        '<div class="smb-badge"><span>' + escapeText(CONTENT.badgeText) + '</span></div>' +
        '<div class="smb-headline-wrap">' +
          '<h3 class="smb-headline"><span>' + CONTENT.headlineHtml + '</span></h3>' +
        '</div>' +
        '<div class="smb-ctas">' +
          ctaHtml('smb-btn-primary', primaryUrl, CONTENT.primaryText) +
          ctaHtml('smb-btn-secondary', secondaryUrl, CONTENT.secondaryText) +
        '</div>' +
      '</div>';

    // Fire analytics on CTA click (re-attached each time the band is rebuilt).
    var primaryBtn = band.querySelector('.smb-btn-primary');
    var secondaryBtn = band.querySelector('.smb-btn-secondary');
    if (primaryBtn) {
      primaryBtn.addEventListener('click', function () {
        trackClick('primary cta', CONTENT.primaryText, primaryUrl);
      });
    }
    if (secondaryBtn) {
      secondaryBtn.addEventListener('click', function () {
        trackClick('secondary cta', CONTENT.secondaryText, secondaryUrl);
      });
    }
    return band;
  }

  // --- styles --------------------------------------------------------------
  function injectStyles() {
    if (document.getElementById(STYLE_ID)) return;
    var c = '#' + BAND_ID;
    var css =
      c + ', ' + c + ' * { box-sizing: border-box; }' +

      // The full-width gradient band.
      c + ' {' +
      ' width: 100%;' +
      ' background: ' + THEME.bandGradient + ';' +
      ' padding: ' + THEME.bandPadding + ';' +
      ' }' +

      // The rounded card inside the band.
      c + ' .smb-card {' +
      ' position: relative;' +
      ' margin: 0 auto;' +
      ' display: flex;' +
      ' flex-direction: column;' +
      ' gap: 16px;' +
      ' width: 100%;' +
      ' max-width: 1200px;' +
      ' border-radius: 24px;' +
      ' background: ' + THEME.cardBg + ';' +
      ' padding: 16px;' +
      ' box-shadow: 0 25px 50px -12px rgba(2, 42, 192, 0.25);' +
      ' }' +
      '@media (min-width: 768px) { ' + c + ' .smb-card { flex-direction: row; align-items: center; } }' +
      '@media (min-width: 1024px) { ' + c + ' .smb-card { gap: 24px; padding: 24px; } }' +

      // Badge pill.
      c + ' .smb-badge {' +
      ' display: inline-flex; align-items: center; justify-content: center;' +
      ' flex-shrink: 0;' +
      ' align-self: flex-start;' + // mobile: compact pill, hug content on the left
      ' background: ' + THEME.badgeBg + ';' +
      ' color: #fff !important;' +
      ' border-radius: 12px; padding: 8px 16px;' +
      ' }' +
      // Desktop (row layout) restores centered cross-axis alignment.
      '@media (min-width: 768px) { ' + c + ' .smb-badge { align-self: center; } }' +
      '@media (min-width: 1024px) { ' + c + ' .smb-badge { border-radius: 16px; } }' +
      c + ' .smb-badge span { display: block; text-align: left; line-height: 1.2; font-weight: 700; font-size: 14px; }' +
      '@media (min-width: 768px) { ' + c + ' .smb-badge span { font-size: 20px; } }' +
      '@media (min-width: 1024px) { ' + c + ' .smb-badge span { font-size: 24px; } }' +

      // Headline.
      c + ' .smb-headline-wrap { display: flex; flex: 1 1 auto; }' +
      c + ' .smb-headline { margin: 0; color: ' + THEME.headlinePrimary + ' !important; line-height: 1.35; font-size: 16px; font-weight: 700; }' +
      '@media (min-width: 1024px) { ' + c + ' .smb-headline { font-size: 20px; } }' +
      c + ' .smb-headline strong { font-weight: 400; color: ' + THEME.headlineSecondary + ' !important; }' +
      c + ' .smb-headline br { display: none; }' +
      '@media (min-width: 1024px) { ' + c + ' .smb-headline br { display: inline; } }' +

      // CTA group.
      c + ' .smb-ctas { display: flex; flex-direction: column; align-items: stretch; width: 100%; gap: 12px; flex-shrink: 0; }' +
      '@media (min-width: 768px) { ' + c + ' .smb-ctas { width: auto; flex-direction: row; align-items: center; } }' +

      // Buttons.
      c + ' .smb-btn {' +
      ' display: inline-flex; align-items: center; justify-content: center;' +
      ' height: 52px; padding: 0 32px;' +
      ' border-radius: 6px; border: 1px solid transparent;' +
      ' font-weight: 700; font-size: 16px; line-height: normal;' +
      ' text-decoration: none; white-space: nowrap;' +
      ' transition: background-color .3s ease, color .3s ease;' +
      ' width: 100%;' +
      ' }' +
      '@media (min-width: 768px) { ' + c + ' .smb-btn { width: auto; } }' +
      c + ' .smb-btn-primary { background: ' + THEME.primaryBtnBg + ' !important; color: #fff !important; }' +
      c + ' .smb-btn-primary:hover { background: ' + THEME.primaryBtnBgHover + ' !important; color: #fff !important; }' +
      c + ' .smb-btn-secondary { background: #fff !important; color: ' + THEME.secondaryBtnText + ' !important; border-color: ' + THEME.secondaryBtnText + ' !important; }' +
      c + ' .smb-btn-secondary:hover { background: #eef6fd !important; color: ' + THEME.secondaryBtnText + ' !important; }' +
      c + ' .smb-btn-icon { display: inline-flex; margin-left: 8px; flex-shrink: 0; }';

    var style = document.createElement('style');
    style.id = STYLE_ID;
    style.type = 'text/css';
    style.appendChild(document.createTextNode(css));
    (document.head || document.documentElement).appendChild(style);
    log('styles injected.');
  }

  // --- insert / keep alive -------------------------------------------------
  function mount() {
	  
	
    for (var i = 0; i < MOUNT.targets.length; i++) {
      var t = MOUNT.targets[i];
      var ref = document.querySelector(t.selector);
      if (!ref) continue;
      var band = buildBand();
      switch (t.position) {
        case 'append':  ref.appendChild(band); break;
        case 'before':  ref.parentNode && ref.parentNode.insertBefore(band, ref); break;
        case 'after':   ref.parentNode && ref.parentNode.insertBefore(band, ref.nextSibling); break;
        case 'prepend':
        default:        ref.insertBefore(band, ref.firstChild); break;
      }
      log('band inserted via', t.selector, '(' + t.position + ').');
      return true;
    }
    log('no mount target found yet.');
    return false;
  }

  // True only when a blade matching REQUIRE_BLADE.selectors is on the page.
  function requiredBladePresent() {
    if (!REQUIRE_BLADE.enabled) return true;
    for (var i = 0; i < REQUIRE_BLADE.selectors.length; i++) {
      if (document.querySelector(REQUIRE_BLADE.selectors[i])) return true;
    }
    return false;
  }

  // Remove the injected band so the page reverts when the blade is absent.
  function teardown() {
    var band = document.getElementById(BAND_ID);
    if (band && band.parentNode) {
      band.parentNode.removeChild(band);
      log('required blade absent — banner removed.');
    }
  }

  function execute() {
    // Page guard: only render on the prospect homepage (required blade present).
    if (!requiredBladePresent()) { teardown(); return false; }
    if (document.getElementById(BAND_ID)) return true; // already present
    injectStyles();
    return mount();
  }

  // Run now + a few retries while the SPA settles.
  execute();
  [100, 300, 800, 1500, 3000, 5000].forEach(function (d) { setTimeout(execute, d); });
	

  // Re-insert if a re-render strips the band. Coalesced to ~once/100ms.
  if (window.MutationObserver) {
    var scheduled = false;
    new MutationObserver(function () {
      if (scheduled) return;
      scheduled = true;
      setTimeout(function () { scheduled = false; execute(); }, 100);
    }).observe(document.body, { childList: true, subtree: true });
  }

  // Belt-and-braces poll.
  setInterval(execute, 1000);
})();
}}, {"id": "c1b1d62a0930479d8fc3f39ab1ed41b0", "type": "append", "dependencies": [], "name": "", "isOpalManaged": false, "selector": "head", "value": "<style>.optv2-blade-wrap {\n    margin: 0;\n    padding-top: 2em;\n}\n.from-\\[\\#00B3FF\\], .headline.text__headline--large {\n    display: none !important; \n  }</style>"}]}]}], "weightDistributions": [{"entityId": "5457558238920704", "endOfRange": 3333}, {"entityId": "5428503993122816", "endOfRange": 6666}, {"entityId": "4638396843294720", "endOfRange": 10000}], "name": null, "bucketingStrategy": null, "experimentMetadata": {"allocationPolicy": "manual", "layerId": "5430125678821376"}, "deployed": false}], "policy": "single_experiment", "viewIds": ["4647535325741056"], "weightDistributions": null, "decisionMetadata": null, "concluded": false}, {"changes": null, "id": "5474456043257856", "name": null, "commitId": "5382814265245696", "groupId": null, "holdback": 0, "activation": {}, "integrationSettings": {"24833400103": {}}, "integrationStringVersion": 2, "experiments": [{"audienceIds": null, "audienceName": null, "changes": null, "id": "4748916546076672", "integrationSettings": null, "variations": [{"id": "4938173541777408", "name": null, "actions": []}, {"id": "5819771413856256", "name": null, "actions": [{"viewId": "4553718536863744", "changes": [{"dependencies": [], "id": "B75F5350-341B-4274-A97C-D87F44476CFC", "name": "", "type": "custom_code", "value": function($){/**
 * Optimizely JS — AU Homepage Top Banner Variations
 * Page: https://www.salesforce.com/au/?forceprofile=prospect
 *
 * Targets the hero banner at the very top of the homepage (the blue gradient
 * section with the "Get started with the #1 Agentic CRM." headline). The live
 * banner is a Tailwind <section> with no stable id, so the script locates it by
 * the stable CTA attribute a[data-name="Start for free"] and climbs to the
 * enclosing <section>. It falls back to the legacy open blade (#q1-homepage)
 * and the classic sf/marquee blade if that markup ever returns.
 *
 * HOW TO CREATE A VARIATION
 * -------------------------
 * Edit the VARIATION object below. Any field left as null is left unchanged
 * from the control, so you only set what you want to test. To run several
 * variations in Optimizely, paste this file into each variation and change the
 * VARIATION values (the ACTIVE comment is just a human label).
 */
(function () {
  'use strict';

  // --- CONFIGURATION: EDIT THIS FOR EACH VARIATION ---
  // ACTIVE: V1 — single-line hero (headline + CTAs, no description)
  //
  // Control (no change): leave every field null.
  // headline       — supports a single <strong> for the highlighted phrase.
  // headlineColor  — hex for the plain part of the headline (control #002C6E).
  // strongColor    — hex for the <strong> highlighted phrase (control #022AC0).
  // description     — plain text; ignored when LAYOUT.singleLine hides it.
  // primaryText/Url — the left "Start for free" button.
  // secondaryText/Url — the right "Watch demo" button.
  var VARIATION = {
    headline: 'The <strong>#1 Agentic CRM</strong>',
    headlineColor: null,
    strongColor: null,
    description: null,
    primaryText: 'Start for free',
    primaryUrl: null,
    secondaryText: 'Watch demo',
    secondaryUrl: null
  };

  // --- LAYOUT: shape the banner ---
  // singleLine     — headline + the two CTAs on ONE centered row; the
  //                  description is hidden and the banner height collapses to
  //                  fit. (Overrides `compact`.)
  // compact        — shrink the standard layout ~50% in height (used only when
  //                  singleLine is false).
  // shrinkHeadline — cap the oversized headline so it takes less room.
  // hideDecor      — hide the decorative star images entirely.
  // decorInline    — true (default): the star flows as the first item in the
  //                  row, beside the headline, so it NEVER overlaps the text at
  //                  any viewport. false: legacy absolute positioning (can
  //                  overlap; only use with manual offsets).
  // decorOffsetX/Y — fine nudge applied on top of the chosen mode. e.g. '8px'.
  // decorScale     — resize the star (1 = original, 0.7 = 70%).
  var LAYOUT = {
    singleLine: true,
    compact: false,
    shrinkHeadline: true,
    hideDecor: false,
    decorInline: true,
    decorOffsetX: '0px',
    decorOffsetY: '0px',
    decorScale: 1
  };

  // Marker classes used to scope the single-line layout CSS to the exact
  // elements we tag at runtime (robust against Tailwind class churn).
  var ROW_CLASS = 'opt-line-row';
  var HEADLINE_COL_CLASS = 'opt-line-headline-col';
  var CTA_COL_CLASS = 'opt-line-cta-col';
  var DECOR_CLASS = 'opt-line-decor';

  // Set to true to print step-by-step diagnostics to the browser console.
  // Leave true while QA'ing; set to false before going live.
  var DEBUG = true;
  function log() {
    if (!DEBUG || !window.console) return;
    var args = ['[homepage-banner]'].concat([].slice.call(arguments));
    console.log.apply(console, args);
  }

  var CHANGED_CLASS = 'optimizely-banner-changed';

  // Selectors for the visible open-blade banner (#q1-homepage hero).
  var OPEN_BLADE_ROOT = '#q1-homepage';
  // Fallback: the classic sf/marquee blade markup.
  var MARQUEE_BLADE_ID = '1770308095565_13zf';

  // --- Helpers ---

  // Resolve the banner container. The live hero is a Tailwind <section> with
  // no stable id, so we anchor on the CTA's stable data-name attribute and
  // climb to the enclosing <section>. The legacy open blade / marquee blade
  // are kept as fallbacks. Returns null until a banner is in the DOM.
  function getBannerRoot() {
    var anchor = document.querySelector(
      'a[data-name="Start for free"], a[data-name="Watch demo"]'
    );
    if (anchor) {
      var section = anchor.closest('section') || anchor.parentElement;
      if (section && section.querySelector('h1')) {
        return { root: section, type: 'hero' };
      }
    }

    var openBlade = document.querySelector(OPEN_BLADE_ROOT);
    if (openBlade) return { root: openBlade, type: 'open' };

    var marquee = document.querySelector('[data-blade-id="' + MARQUEE_BLADE_ID + '"]');
    if (marquee) return { root: marquee, type: 'marquee' };

    return null;
  }

  // True if Optimizely is even running its variation code on this page view.
  function optimizelyActive() {
    return !!(window.optimizely && typeof window.optimizely.get === 'function');
  }

  // Inject compact-layout CSS once. Rules are scoped to the banner via
  // CHANGED_CLASS, so they only apply after applyVariation tags the section
  // and never leak to the rest of the page. !important is needed to win
  // against Tailwind utility classes on the hero.
  var STYLE_ID = 'optimizely-banner-style';
  function injectStyles() {
    if (document.getElementById(STYLE_ID)) return;
    if (!LAYOUT.singleLine && !LAYOUT.compact && !LAYOUT.shrinkHeadline) return;

    var css = '';
    if (LAYOUT.singleLine) {
      // Decorative star handling. Default (decorInline) puts the star INTO the
      // flex flow as the first row item, so it sits beside the headline with a
      // real gap and never overlaps text at any viewport. Legacy mode keeps it
      // absolutely positioned (can overlap). Both honour offset + scale.
      var dx = LAYOUT.decorOffsetX || '0px';
      var dy = LAYOUT.decorOffsetY || '0px';
      var dScale = (LAYOUT.decorScale != null ? LAYOUT.decorScale : 1);
      var decorRule, decorMediaRule;
      if (LAYOUT.decorInline === false) {
        decorRule =
          '.' + DECOR_CLASS + ' {' +
          ' left: 0 !important; right: auto !important; top: 0 !important;' +
          ' transform: translate(' + dx + ', ' + dy + ') scale(' + dScale + ') !important;' +
          ' }';
        decorMediaRule = '';
      } else {
        // Inline mode: the star only appears in the side-by-side row layout
        // (>=1024px), where it sits next to the headline. Below that the row
        // stacks into a column, which would push the star onto its own line
        // ABOVE the headline — so we hide it there entirely.
        decorRule =
          '.' + DECOR_CLASS + ' {' +
          ' display: none !important;' +
          ' }';
        decorMediaRule =
          '  .' + DECOR_CLASS + ' {' +
          '   display: flex !important;' +
          '   position: static !important;' +
          '   order: -1 !important;' +
          '   flex: 0 0 auto !important;' +
          '   align-self: center !important;' +
          '   width: calc(72px * ' + dScale + ') !important;' +
          '   height: auto !important;' +
          '   margin: 0 !important;' +
          '   transform: translate(' + dx + ', ' + dy + ') !important;' +
          '  }';
      }

      // Responsive single-line hero. Mobile-first: headline stacked above the
      // CTA cluster, everything centered, tight spacing. At >=1024px it becomes
      // one centered row (headline + buttons side by side). Direction/gap are
      // set explicitly here rather than relying on Tailwind's breakpoints, so
      // the behaviour is predictable at every width. Buttons are allowed to
      // wrap so they never overflow on narrow screens.
      css +=
        // --- base / mobile-first: stacked + centered ---
        '.' + ROW_CLASS + ' {' +
        ' display: flex !important;' +
        ' flex-direction: column !important;' +
        ' align-items: center !important;' +
        ' justify-content: center !important;' +
        ' gap: 16px !important;' +
        ' padding-top: 18px !important;' +
        ' padding-bottom: 18px !important;' +
        ' text-align: center !important;' +
        ' }' +
        // Every direct child of the row is vertically centered with no stray
        // vertical margin, so the star, headline and buttons share one centre
        // line at all widths.
        '.' + ROW_CLASS + ' > * {' +
        ' align-self: center !important;' +
        ' margin-top: 0 !important;' +
        ' margin-bottom: 0 !important;' +
        ' }' +
        '.' + HEADLINE_COL_CLASS + ' {' +
        ' display: flex !important;' +
        ' align-items: center !important;' +
        ' width: auto !important;' +
        ' max-width: 100% !important;' +
        ' flex: 0 1 auto !important;' +
        ' justify-content: center !important;' +
        ' }' +
        // Heading carries no margin so its text box centres cleanly.
        '.' + CHANGED_CLASS + ' h1 {' +
        ' margin: 0 !important;' +
        ' padding: 0 !important;' +
        ' }' +
        '.' + CTA_COL_CLASS + ' {' +
        ' display: flex !important;' +
        ' width: auto !important;' +
        ' max-width: 100% !important;' +
        ' flex: 0 0 auto !important;' +
        ' align-items: center !important;' +
        ' justify-content: center !important;' +
        ' }' +
        // CTA wrapper: horizontal, wrap, vertically centered, content-width.
        '.' + CTA_COL_CLASS + ' > div {' +
        ' display: flex !important;' +
        ' flex-direction: row !important;' +
        ' flex-wrap: wrap !important;' +
        ' align-items: center !important;' +
        ' width: auto !important;' +
        ' gap: 12px !important;' +
        ' justify-content: center !important;' +
        ' }' +
        '.' + CTA_COL_CLASS + ' a {' +
        ' width: auto !important;' +
        ' }' +
        decorRule +
        // --- wide screens (>=1024px): one centered row ---
        '@media (min-width: 1024px) {' +
        '  .' + ROW_CLASS + ' {' +
        '   flex-direction: row !important;' +
        '   gap: 40px !important;' +
        '   padding-top: 22px !important;' +
        '   padding-bottom: 22px !important;' +
        '   text-align: left !important;' +
        '  }' +
        decorMediaRule +
        '}';
    } else if (LAYOUT.compact) {
      // Halve the vertical padding + column gap on the inner flex container
      // (section > div > div). Control is ~py-30 / gap-60 on desktop.
      css +=
        '.' + CHANGED_CLASS + ' > div > div {' +
        ' padding-top: 16px !important;' +
        ' padding-bottom: 16px !important;' +
        ' gap: 24px !important;' +
        ' }';
    }
    if (LAYOUT.shrinkHeadline) {
      // Cap the oversized hero headline (control scales up to 70px) and
      // tighten line-height + paragraph spacing so it reads less bulky.
      css +=
        '.' + CHANGED_CLASS + ' h1 {' +
        ' font-size: clamp(28px, 4.5vw, 44px) !important;' +
        ' line-height: 1.1 !important;' +
        ' }' +
        '.' + CHANGED_CLASS + ' p {' +
        ' line-height: 1.4 !important;' +
        ' }';
    }

    var style = document.createElement('style');
    style.id = STYLE_ID;
    style.type = 'text/css';
    style.appendChild(document.createTextNode(css));
    (document.head || document.documentElement).appendChild(style);
    log('compact styles injected.');
  }

  function findHeadline(banner) {
    // Open blade and marquee both expose the hero headline as the first h1/h2.
    return banner.root.querySelector('h1') || banner.root.querySelector('.headline');
  }

  function findDescription(banner) {
    if (banner.type === 'marquee') {
      return banner.root.querySelector('.blade__description p');
    }
    // Open blade: the supporting paragraph sits in the right-hand text column.
    // It is the paragraph that is NOT inside the headline.
    var paragraphs = banner.root.querySelectorAll('p');
    for (var i = 0; i < paragraphs.length; i++) {
      if (!paragraphs[i].closest('h1') && (paragraphs[i].innerText || '').trim().length > 0) {
        return paragraphs[i];
      }
    }
    return paragraphs.length ? paragraphs[0] : null;
  }

  // Locate a CTA by its current label text, scoped to the banner. This is
  // resilient to class-name changes and works for both blade types.
  function findCtaByText(banner, text) {
    var links = banner.root.querySelectorAll('a');
    for (var i = 0; i < links.length; i++) {
      var label = (links[i].getAttribute('data-name') || links[i].innerText || '').trim();
      if (label.toLowerCase() === text.toLowerCase()) return links[i];
    }
    return null;
  }

  // Replace only the visible label text of a link without destroying child
  // markup (icons, svgs). Falls back to textContent if no text node is found.
  function setLinkLabel(link, newText) {
    for (var i = 0; i < link.childNodes.length; i++) {
      var node = link.childNodes[i];
      if (node.nodeType === 3 && node.nodeValue.trim().length > 0) {
        node.nodeValue = newText;
        return;
      }
    }
    link.textContent = newText;
  }

  // Lowest common ancestor of two nodes (the flex "row" that holds both the
  // headline column and the CTA column, regardless of how deeply nested).
  function lowestCommonAncestor(a, b) {
    if (!a || !b) return null;
    var ancestors = [];
    for (var n = a; n; n = n.parentElement) ancestors.push(n);
    for (var m = b; m; m = m.parentElement) {
      if (ancestors.indexOf(m) !== -1) return m;
    }
    return null;
  }

  // The direct child of `row` that contains `node` (i.e. the column wrapper).
  function columnOf(row, node) {
    var child = node;
    while (child && child.parentElement !== row) child = child.parentElement;
    return child; // null if node is not inside row
  }

  // Reshape the hero into a single centered row: hide the description, hide
  // decorative images, and tag the headline column / CTA column / row so the
  // injected CSS can target them. Works for any structure where the headline
  // and the CTAs share a common flex ancestor (computed at runtime), so it
  // does not depend on exact nesting depth or the banner "type".
  function applySingleLineLayout(banner) {
    var headline = findHeadline(banner);
    var primary = findCtaByText(banner, 'Start for free') ||
                  findCtaByText(banner, 'Start free trial');
    var secondary = findCtaByText(banner, 'Watch demo');
    var desc = findDescription(banner);

    if (!headline || !primary) {
      log('single-line layout skipped: headline or CTA not found.', headline, primary);
      return;
    }

    // The shared flex row that holds both columns.
    var row = lowestCommonAncestor(headline, primary);
    if (!row) {
      log('single-line layout skipped: no common ancestor for headline + CTA.');
      return;
    }
    row.classList.add(ROW_CLASS);

    // Column wrappers = the row's direct children that hold each piece.
    var headlineCol = columnOf(row, headline);
    var ctaCol = columnOf(row, primary);
    if (headlineCol) headlineCol.classList.add(HEADLINE_COL_CLASS);
    if (ctaCol) ctaCol.classList.add(CTA_COL_CLASS);
    log('single-line layout tagged. row=', row, 'headlineCol=', headlineCol, 'ctaCol=', ctaCol);

    // Hide the description block (its wrapper div, so no empty gap remains),
    // but never hide the headline or CTA columns themselves.
    if (desc) {
      var descWrap = (desc.parentElement && desc.parentElement !== banner.root)
        ? desc.parentElement : desc;
      if (descWrap !== headlineCol && descWrap !== ctaCol &&
          !descWrap.contains(primary) && (!secondary || !descWrap.contains(secondary)) &&
          !descWrap.contains(headline)) {
        descWrap.style.setProperty('display', 'none', 'important');
        log('description hidden for single-line layout.');
      } else {
        log('description wrapper overlaps a kept column; hiding the <p> only.');
        desc.style.setProperty('display', 'none', 'important');
      }
    }

    // Decorative, absolutely-positioned children of the row. Only the star that
    // actually has an image src is kept/flowed; empty decor placeholders are
    // hidden so they don't add a phantom gap when flowed inline.
    var kids = row.children;
    for (var i = 0; i < kids.length; i++) {
      if (kids[i] === headlineCol || kids[i] === ctaCol) continue;
      var style = window.getComputedStyle(kids[i]);
      if (!style || style.position !== 'absolute') continue;

      var img = kids[i].querySelector('img');
      var hasImage = img && img.getAttribute('src') &&
                     img.getAttribute('src').trim().length > 0;

      if (LAYOUT.hideDecor || !hasImage) {
        kids[i].style.setProperty('display', 'none', 'important');
      } else {
        kids[i].classList.add(DECOR_CLASS);
      }
    }
  }

  // --- Apply variation ---

  function applyVariation(banner) {
    var appliedSomething = false;
    log('banner found. type =', banner.type, banner.root);

    // 1. Headline (and optional colours)
    if (VARIATION.headline != null) {
      var headline = findHeadline(banner);
      log('headline element:', headline);
      if (headline) {
        headline.innerHTML = VARIATION.headline;
        appliedSomething = true;
      } else {
        log('WARNING: headline not found inside banner.');
      }
    }
    if (VARIATION.headlineColor != null) {
      var hEl = findHeadline(banner);
      if (hEl) { hEl.style.color = VARIATION.headlineColor; appliedSomething = true; }
    }
    if (VARIATION.strongColor != null) {
      var hForStrong = findHeadline(banner);
      var strong = hForStrong && hForStrong.querySelector('strong');
      if (strong) { strong.style.color = VARIATION.strongColor; appliedSomething = true; }
    }

    // 2. Description paragraph
    if (VARIATION.description != null) {
      var desc = findDescription(banner);
      log('description element:', desc);
      if (desc) { desc.innerText = VARIATION.description; appliedSomething = true; }
    }

    // 3. Primary CTA ("Start for free")
    var primary = findCtaByText(banner, 'Start for free') || findCtaByText(banner, 'Start free trial');
    log('primary CTA element:', primary);
    if (primary) {
      if (VARIATION.primaryText != null) { setLinkLabel(primary, VARIATION.primaryText); appliedSomething = true; }
      if (VARIATION.primaryUrl != null) { primary.setAttribute('href', VARIATION.primaryUrl); appliedSomething = true; }
    }

    // 4. Secondary CTA ("Watch demo")
    var secondary = findCtaByText(banner, 'Watch demo');
    log('secondary CTA element:', secondary);
    if (secondary) {
      if (VARIATION.secondaryText != null) { setLinkLabel(secondary, VARIATION.secondaryText); appliedSomething = true; }
      if (VARIATION.secondaryUrl != null) { secondary.setAttribute('href', VARIATION.secondaryUrl); appliedSomething = true; }
    }

    // Layout tweaks apply whenever we have the banner, even if no text changed.
    // Guarded so a layout hiccup can't block the style injection / class tag.
    try {
      if (LAYOUT.singleLine) applySingleLineLayout(banner);
    } catch (e) {
      log('ERROR in applySingleLineLayout:', e && e.message ? e.message : e);
    }
    injectStyles();
    banner.root.classList.add(CHANGED_CLASS);

    if (appliedSomething) {
      log('applied variation successfully.');
    } else {
      log('banner found but nothing was changed (check the warnings above).');
    }
    return appliedSomething;
  }

  // The plain-text headline we expect to see once applied. Used to detect when
  // a React re-render has reverted our edit (class alone is not enough).
  function expectedHeadlineText() {
    if (VARIATION.headline == null) return null;
    var tmp = document.createElement('div');
    tmp.innerHTML = VARIATION.headline;
    return (tmp.textContent || '').replace(/\s+/g, ' ').trim();
  }

  // Considered applied only if the banner exists AND the *visible state* still
  // matches our variation. This survives SPA hydration/re-renders that keep the
  // node (and our class) but reset its contents.
  function isApplied() {
    var banner = getBannerRoot();
    if (!banner) return false;

    var want = expectedHeadlineText();
    if (want != null) {
      var h = findHeadline(banner);
      var have = h ? (h.textContent || '').replace(/\s+/g, ' ').trim() : null;
      if (have !== want) return false;
    }

    if (LAYOUT.singleLine &&
        !banner.root.classList.contains(ROW_CLASS) &&
        !banner.root.querySelector('.' + ROW_CLASS)) {
      return false;
    }

    return banner.root.classList.contains(CHANGED_CLASS);
  }

  // Re-apply guard: cap only CONSECUTIVE failed applies (re-applies where our
  // change never sticks). The counter resets every time we observe the
  // variation successfully applied, so ordinary resize/re-render reverts over a
  // long session never exhaust it — only a genuine runaway fight would.
  var consecutiveApplies = 0;
  var MAX_CONSECUTIVE = 30;

  function execute() {
    if (isApplied()) { consecutiveApplies = 0; return true; }
    if (consecutiveApplies >= MAX_CONSECUTIVE) return true; // back off, avoid runaway
    var banner = getBannerRoot();
    if (!banner) return false;
    consecutiveApplies++;
    if (consecutiveApplies > 1) log('re-applying (previous changes were reverted).');
    return applyVariation(banner);
  }

  // --- Run with multiple strategies (matches existing project conventions) ---

  log('script loaded. optimizely active on page =', optimizelyActive());

  // Try immediately.
  execute();

  // Retry on a few delays for late-rendering / re-hydrating banners.
  [100, 300, 800, 1500, 3000, 5000].forEach(function (delay) {
    setTimeout(execute, delay);
  });

  // After the last retry window, if we still found no banner, say so loudly.
  setTimeout(function () {
    if (!getBannerRoot()) {
      log('NO BANNER FOUND after 3.5s. Could not locate a <section> via the ' +
          'CTA anchor a[data-name="Start for free"]/[data-name="Watch demo"], ' +
          'nor the legacy blade selectors. The markup likely changed.');
    }
  }, 3500);

  // Optimizely waitUntil fallback, if available.
  var utils = window.optimizely && window.optimizely.get && window.optimizely.get('utils');
  if (utils && utils.waitUntil) {
    utils.waitUntil(function () {
      return !!getBannerRoot();
    }, { timeout: 12000 }).then(execute).catch(function () { /* other strategies handle it */ });
  }

  // Watch for DOM changes and RE-APPLY whenever our changes get wiped by a
  // re-render. We keep this running for the page lifetime (NOT just the first
  // few seconds): Salesforce re-renders the hero responsively, so a window
  // resize long after load can otherwise restore the control headline. Mutation
  // bursts are coalesced so we run at most once per ~50ms.
  if (window.MutationObserver) {
    var scheduled = false;
    var observer = new MutationObserver(function () {
      if (scheduled) return;
      scheduled = true;
      setTimeout(function () {
        scheduled = false;
        execute();
      }, 50);
    });
    observer.observe(document.body, { childList: true, subtree: true, characterData: true });
  }

  // Re-apply on viewport changes — these trigger the responsive re-render that
  // reverts the headline mid-drag. Debounced so a drag fires a few checks, not
  // hundreds.
  var resizeTimer = null;
  function onViewportChange() {
    consecutiveApplies = 0; // a resize is a fresh chance, not part of a runaway
    if (resizeTimer) clearTimeout(resizeTimer);
    resizeTimer = setTimeout(execute, 60);
  }
  window.addEventListener('resize', onViewportChange, { passive: true });
  window.addEventListener('orientationchange', onViewportChange, { passive: true });
  window.addEventListener('pageshow', onViewportChange, { passive: true });

  // Belt-and-braces: a low-frequency poll that re-applies if reverted, in case
  // a repaint somehow doesn't trigger an observed mutation or resize event.
  setInterval(execute, 1000);
})();
}, "isOpalManaged": false}]}]}, {"id": "4901800470380544", "name": null, "actions": [{"viewId": "4553718536863744", "changes": [{"id": "132661AC-170D-4808-8ED6-53CB7BB50B82", "type": "append", "dependencies": [], "name": "", "isOpalManaged": false, "selector": "head", "value": "<style>.optv2-blade-wrap {\n    margin: 0;\n    padding-top: 2em;\n}\n.from-\\[\\#00B3FF\\] {\n    display: none !important; \n  }</style>"}, {"id": "124DC754-F1B4-45BC-BDCD-B9D19C2BF380", "type": "custom_code", "dependencies": [], "name": "", "isOpalManaged": false, "value": function($){/**
 * Optimizely JS — Standalone "Small business?" notification banner
 * Page: https://www.salesforce.com/au/?forceprofile=prospect
 */
(function () {
  'use strict';

  // --- CONTENT -------------------------------------------------------------
  var CONTENT = {
    badgeText: 'Small business?',
    // HTML allowed. <br> only shows on large screens (see CSS).
    headlineHtml:
      'Get started for free with the&nbsp;#1 Agentic CRM ' +
      '<br><strong>Nothing to install, no credit card required</strong>',
    primaryText: 'Start for free',
    primaryUrl:
      'https://www.salesforce.com/au/small-business/free-trial/starter-suite-v2/?d=pb',
    secondaryText: 'Watch demo',
    secondaryUrl:
      'https://www.salesforce.com/au/small-business/demos/smb-overview/?d=pb',
    showArrowIcons: true,
    // If true, try to inherit the page's live CTA hrefs (by matching link text
    // / data-name) and use them instead of the URLs above.
    inheritLiveLinks: true
  };

  // --- MOUNT: where the band is inserted -----------------------------------

  var MOUNT = {
    targets: [
      { selector: '.relative.overflow-hidden.direction-2-background', position: 'prepend' }
    ]
  };

  // --- REMOVE: hide the original hero <section> ----------------------------

  var REMOVE = {
    enabled: true,
    // A section matches if its class contains ANY of these substrings...
    classContains: ['from-[#00B3FF]'],
    // ...OR it contains a CTA with one of these data-name values.
    ctaDataNames: ['Start for free', 'Watch demo']
  };

  // --- REQUIRE_BLADE: only render on the prospect homepage -----------------
  // The banner only renders when a blade matching ANY of these selectors is
  // present. This blade exists on the PROSPECT homepage but not the customer
  // version, so it scopes the banner to prospects. If the blade is absent — or
  // disappears on a re-render — the banner is removed again.
  // (ids starting with a digit can't be a '#id' selector, so we match the
  // [data-blade-id] attribute.)
  var REQUIRE_BLADE = {
    enabled: true,
    selectors: ['[data-blade-id="1760990151581_lbv"]']
  };

  // --- THEME ---------------------------------------------------------------
  var THEME = {
    // Matches the original hero's Tailwind gradient:
    // bg-gradient-to-b from-[#00B3FF] from-[18.78%] to-[#90D0FE]
    // ('to bottom', light-blue #00B3FF at 18.78% -> pale-blue #90D0FE).
    // Use 'transparent' for no band background.
    //bandGradient: 'linear-gradient(to bottom, #00B3FF 18.78%, #90D0FE)',
    bandPadding: '24px 16px',          // space around the card inside the band
    cardBg: '#E8F3FE',                 // light card background
    badgeBg: '#022AC0',
    headlinePrimary: '#022AC0',
    headlineSecondary: '#032D60',
    primaryBtnBg: '#0176D3',
    primaryBtnBgHover: '#014486',
    secondaryBtnText: '#0176D3'
  };

  // --- ANALYTICS -----------------------------------------------------------
  // Our injected CTAs aren't Page Builder markup, so the site's GTM "GA4 -
  // Content Click" tag never fires for them. On click we push the same event
  // to window.dataLayer ourselves. The field schema below mirrors the original
  // CTA's GA4 Content Click payload (from the debug log); GTM still fills the
  // page-level dimensions (locale, region, sf_page_name …) from its own
  // variables. VERIFY in GTM Preview / GA4 DebugView and tweak `eventName`/
  // fields if your container expects different keys.
  var ANALYTICS = {
    enabled: true,
    eventName: 'custEv_contentClick',  // GTM Custom Event trigger name
    blade: {
      blade_id: '',                    // optional; set to mirror a blade id
      blade_name: 'text-banner-link1',
      blade_source: 'www',
      blade_state: 'rendered',
      blade_type: 'blade',
      blade_variant: 'sf/q2-homepage'
    }
  };

  // Set false to silence console logs.
  var DEBUG = true;
  function log() {
    if (!DEBUG || !window.console) return;
    console.log.apply(console, ['[smb-banner]'].concat([].slice.call(arguments)));
  }

  var BAND_ID = 'smb-banner-band';
  var STYLE_ID = 'smb-banner-style';

  var ARROW_SVG =
    '<span class="smb-btn-icon" aria-hidden="true">' +
    '<svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" fill="currentColor">' +
    '<path fill-rule="evenodd" clip-rule="evenodd" d="M10.0977 2.16345H14.5237L6.8804 9.80671C6.69002 9.99709 6.69002 10.3058 6.8804 10.4961L7.34002 10.9558C7.5304 11.1461 7.83906 11.1461 8.02945 10.9558L15.6717 3.31348V7.73848C15.6717 8.00772 15.89 8.22598 16.1592 8.22598H16.8092C17.0785 8.22598 17.2967 8.00772 17.2967 7.73848V1.47595C17.2967 0.958186 16.877 0.538452 16.3592 0.538452H10.0977C9.82847 0.538452 9.61021 0.756713 9.61021 1.02595V1.67595C9.61021 1.94519 9.82847 2.16345 10.0977 2.16345ZM2.97559 4.03905C1.62939 4.03905 0.538086 5.13036 0.538086 6.47655V14.8516C0.538086 16.1977 1.62939 17.2891 2.97559 17.2891H11.3506C12.6968 17.2891 13.7881 16.1977 13.7881 14.8516L13.7881 8.88513C13.7881 8.59574 13.4383 8.45066 13.2335 8.65509L12.4493 9.43768C12.2661 9.62059 12.1631 9.86888 12.1631 10.1278V14.8516C12.1631 15.3003 11.7993 15.6641 11.3506 15.6641H2.97559C2.52686 15.6641 2.16309 15.3003 2.16309 14.8516V6.47655C2.16309 6.02782 2.52685 5.66405 2.97559 5.66405H7.79909C8.07127 5.66405 8.33106 5.55029 8.51564 5.35026L9.2223 4.58446C9.41442 4.37626 9.26675 4.03905 8.98345 4.03905H2.97559Z"></path>' +
    '</svg></span>';

  // --- helpers -------------------------------------------------------------
  function escapeText(str) {
    return String(str == null ? '' : str)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function escapeAttr(str) { return escapeText(str).replace(/'/g, '&#39;'); }

  // Inherit a live CTA href by matching visible link text / data-name.
  function liveHref(text) {
    if (!CONTENT.inheritLiveLinks) return null;
    var links = document.querySelectorAll('a[href]');
    for (var i = 0; i < links.length; i++) {
      var label = (links[i].getAttribute('data-name') || links[i].textContent || '').trim();
      if (label.toLowerCase() === text.toLowerCase()) {
        var href = links[i].getAttribute('href');
        if (href && href !== '#') return href;
      }
    }
    return null;
  }

  // Push the site's GA4 "Content Click" event to dataLayer for our CTAs.
  // linkType is 'primary cta' | 'secondary cta' (mirrors module_link_type).
  function trackClick(linkType, text, url) {
    if (!ANALYTICS.enabled) return;
    try {
      window.dataLayer = window.dataLayer || [];
      var payload = {
        event: ANALYTICS.eventName,
        dl_event: ANALYTICS.eventName,
        click_text: text,
        click_url: url,
        module_link_type: linkType,
        module_type: 'cta',
        destination_type: 'internal',
        content_category: 'module',
        internal_link_click: 1,
        module_clicks: 1,
        cta_clicks: 0,
        blade_module_name: text
      };
      var b = ANALYTICS.blade || {};
      for (var key in b) {
        if (b.hasOwnProperty(key) && b[key] !== '') payload[key] = b[key];
      }
      if (b.blade_id) payload.module_id = b.blade_id;
      window.dataLayer.push(payload);
      log('analytics: pushed', ANALYTICS.eventName, '|', linkType, '|', text);
    } catch (e) {
      log('analytics push failed', e);
    }
  }

  // --- markup --------------------------------------------------------------
  function ctaHtml(extraClass, href, text) {
    return '<a class="smb-btn ' + extraClass + '" href="' + escapeAttr(href) + '" ' +
      'target="_blank" rel="noopener noreferrer">' + escapeText(text) +
      (CONTENT.showArrowIcons ? ARROW_SVG : '') + '</a>';
  }

  function buildBand() {
    var primaryUrl = liveHref(CONTENT.primaryText) || CONTENT.primaryUrl;
    var secondaryUrl = liveHref(CONTENT.secondaryText) || CONTENT.secondaryUrl;

    var band = document.createElement('div');
    band.id = BAND_ID;
    band.innerHTML =
      '<div class="smb-card">' +
        '<div class="smb-badge"><span>' + escapeText(CONTENT.badgeText) + '</span></div>' +
        '<div class="smb-headline-wrap">' +
          '<h3 class="smb-headline"><span>' + CONTENT.headlineHtml + '</span></h3>' +
        '</div>' +
        '<div class="smb-ctas">' +
          ctaHtml('smb-btn-primary', primaryUrl, CONTENT.primaryText) +
          ctaHtml('smb-btn-secondary', secondaryUrl, CONTENT.secondaryText) +
        '</div>' +
      '</div>';

    // Fire analytics on CTA click (re-attached each time the band is rebuilt).
    var primaryBtn = band.querySelector('.smb-btn-primary');
    var secondaryBtn = band.querySelector('.smb-btn-secondary');
    if (primaryBtn) {
      primaryBtn.addEventListener('click', function () {
        trackClick('primary cta', CONTENT.primaryText, primaryUrl);
      });
    }
    if (secondaryBtn) {
      secondaryBtn.addEventListener('click', function () {
        trackClick('secondary cta', CONTENT.secondaryText, secondaryUrl);
      });
    }
    return band;
  }

  // --- styles --------------------------------------------------------------
  function injectStyles() {
    if (document.getElementById(STYLE_ID)) return;
    var c = '#' + BAND_ID;
    var css =
      c + ', ' + c + ' * { box-sizing: border-box; }' +

      // The full-width gradient band.
      c + ' {' +
      ' width: 100%;' +
      ' background: ' + THEME.bandGradient + ';' +
      ' padding: ' + THEME.bandPadding + ';' +
      ' }' +

      // The rounded card inside the band.
      c + ' .smb-card {' +
      ' position: relative;' +
      ' margin: 0 auto;' +
      ' display: flex;' +
      ' flex-direction: column;' +
      ' gap: 16px;' +
      ' width: 100%;' +
      ' max-width: 1200px;' +
      ' border-radius: 24px;' +
      ' background: ' + THEME.cardBg + ';' +
      ' padding: 16px;' +
      ' box-shadow: 0 25px 50px -12px rgba(2, 42, 192, 0.25);' +
      ' }' +
      '@media (min-width: 768px) { ' + c + ' .smb-card { flex-direction: row; align-items: center; } }' +
      '@media (min-width: 1024px) { ' + c + ' .smb-card { gap: 24px; padding: 24px; } }' +

      // Badge pill.
      c + ' .smb-badge {' +
      ' display: inline-flex; align-items: center; justify-content: center;' +
      ' flex-shrink: 0;' +
      ' align-self: flex-start;' + // mobile: compact pill, hug content on the left
      ' background: ' + THEME.badgeBg + ';' +
      ' color: #fff !important;' +
      ' border-radius: 12px; padding: 8px 16px;' +
      ' }' +
      // Desktop (row layout) restores centered cross-axis alignment.
      '@media (min-width: 768px) { ' + c + ' .smb-badge { align-self: center; } }' +
      '@media (min-width: 1024px) { ' + c + ' .smb-badge { border-radius: 16px; } }' +
      c + ' .smb-badge span { display: block; text-align: left; line-height: 1.2; font-weight: 700; font-size: 14px; }' +
      '@media (min-width: 768px) { ' + c + ' .smb-badge span { font-size: 20px; } }' +
      '@media (min-width: 1024px) { ' + c + ' .smb-badge span { font-size: 24px; } }' +

      // Headline.
      c + ' .smb-headline-wrap { display: flex; flex: 1 1 auto; }' +
      c + ' .smb-headline { margin: 0; color: ' + THEME.headlinePrimary + ' !important; line-height: 1.35; font-size: 16px; font-weight: 700; }' +
      '@media (min-width: 1024px) { ' + c + ' .smb-headline { font-size: 20px; } }' +
      c + ' .smb-headline strong { font-weight: 400; color: ' + THEME.headlineSecondary + ' !important; }' +
      c + ' .smb-headline br { display: none; }' +
      '@media (min-width: 1024px) { ' + c + ' .smb-headline br { display: inline; } }' +

      // CTA group.
      c + ' .smb-ctas { display: flex; flex-direction: column; align-items: stretch; width: 100%; gap: 12px; flex-shrink: 0; }' +
      '@media (min-width: 768px) { ' + c + ' .smb-ctas { width: auto; flex-direction: row; align-items: center; } }' +

      // Buttons.
      c + ' .smb-btn {' +
      ' display: inline-flex; align-items: center; justify-content: center;' +
      ' height: 52px; padding: 0 32px;' +
      ' border-radius: 6px; border: 1px solid transparent;' +
      ' font-weight: 700; font-size: 16px; line-height: normal;' +
      ' text-decoration: none; white-space: nowrap;' +
      ' transition: background-color .3s ease, color .3s ease;' +
      ' width: 100%;' +
      ' }' +
      '@media (min-width: 768px) { ' + c + ' .smb-btn { width: auto; } }' +
      c + ' .smb-btn-primary { background: ' + THEME.primaryBtnBg + ' !important; color: #fff !important; }' +
      c + ' .smb-btn-primary:hover { background: ' + THEME.primaryBtnBgHover + ' !important; color: #fff !important; }' +
      c + ' .smb-btn-secondary { background: #fff !important; color: ' + THEME.secondaryBtnText + ' !important; border-color: ' + THEME.secondaryBtnText + ' !important; }' +
      c + ' .smb-btn-secondary:hover { background: #eef6fd !important; color: ' + THEME.secondaryBtnText + ' !important; }' +
      c + ' .smb-btn-icon { display: inline-flex; margin-left: 8px; flex-shrink: 0; }';

    var style = document.createElement('style');
    style.id = STYLE_ID;
    style.type = 'text/css';
    style.appendChild(document.createTextNode(css));
    (document.head || document.documentElement).appendChild(style);
    log('styles injected.');
  }

  // --- insert / keep alive -------------------------------------------------
  function mount() {
	  
	
    for (var i = 0; i < MOUNT.targets.length; i++) {
      var t = MOUNT.targets[i];
      var ref = document.querySelector(t.selector);
      if (!ref) continue;
      var band = buildBand();
      switch (t.position) {
        case 'append':  ref.appendChild(band); break;
        case 'before':  ref.parentNode && ref.parentNode.insertBefore(band, ref); break;
        case 'after':   ref.parentNode && ref.parentNode.insertBefore(band, ref.nextSibling); break;
        case 'prepend':
        default:        ref.insertBefore(band, ref.firstChild); break;
      }
      log('band inserted via', t.selector, '(' + t.position + ').');
      return true;
    }
    log('no mount target found yet.');
    return false;
  }

  // True only when a blade matching REQUIRE_BLADE.selectors is on the page.
  function requiredBladePresent() {
    if (!REQUIRE_BLADE.enabled) return true;
    for (var i = 0; i < REQUIRE_BLADE.selectors.length; i++) {
      if (document.querySelector(REQUIRE_BLADE.selectors[i])) return true;
    }
    return false;
  }

  // Remove the injected band so the page reverts when the blade is absent.
  function teardown() {
    var band = document.getElementById(BAND_ID);
    if (band && band.parentNode) {
      band.parentNode.removeChild(band);
      log('required blade absent — banner removed.');
    }
  }

  function execute() {
    // Page guard: only render on the prospect homepage (required blade present).
    if (!requiredBladePresent()) { teardown(); return false; }
    if (document.getElementById(BAND_ID)) return true; // already present
    injectStyles();
    return mount();
  }

  // Run now + a few retries while the SPA settles.
  execute();
  [100, 300, 800, 1500, 3000, 5000].forEach(function (d) { setTimeout(execute, d); });
	

  // Re-insert if a re-render strips the band. Coalesced to ~once/100ms.
  if (window.MutationObserver) {
    var scheduled = false;
    new MutationObserver(function () {
      if (scheduled) return;
      scheduled = true;
      setTimeout(function () { scheduled = false; execute(); }, 100);
    }).observe(document.body, { childList: true, subtree: true });
  }

  // Belt-and-braces poll.
  setInterval(execute, 1000);
