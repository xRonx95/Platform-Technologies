// 	var newBlade = '<div data-blade-id="1779419772161_1b7e" data-blade-name="sf/nup" data-blade-position="1" data-blade-source="www" data-blade-type="blade" data-blade-variant="nup"><section class="layout--1 nup--blade nup--card_quote relative" id="1779419772161_1b7e"><div class="container container--min-spacing-bottom container--min-spacing-top"><div class="grid grid_main no-header nup nup__1"><div class="cards cards--minimal theme--light"><article class="card card__1 card__wrapper" data-module-id="1779419779113_9x3" data-module-name="Rudi Khoury" data-module-position="1" data-module-track-impressions="" data-module-type="card_quote"><div class="border-rad-16 card--card_quote flex pbc-g-elevation-2"><div class="card_quote_align--right"><div class="card__image__wrapper"><img alt="Fisher & Paykel logo" class="card__image" height="250" sizes="100vw" src="https://wp.sfdcdigital.com/en-au/wp-content/uploads/sites/12/2026/01/fisher-paykel.png?w=1024" srcset="https://wp.sfdcdigital.com/en-au/wp-content/uploads/sites/12/2026/01/fisher-paykel.png?resize=150,150 150w,https://wp.sfdcdigital.com/en-au/wp-content/uploads/sites/12/2026/01/fisher-paykel.png?resize=300,73 300w,https://wp.sfdcdigital.com/en-au/wp-content/uploads/sites/12/2026/01/fisher-paykel.png?resize=768,187 768w,https://wp.sfdcdigital.com/en-au/wp-content/uploads/sites/12/2026/01/fisher-paykel.png?resize=1024,250 1024w" width="1024"></div><div class="card__content__wrapper"><blockquote class="card__copy__wrapper"><div class="card__quote--au card__quote-mark" aria-hidden="true"></div><h3 class="card__headline">By connecting all our data, we can better understand customers\' needs and then use automation to reach out to them in real-time with the information or products they most want.</h3><div class="tagline_wrapper"><div class="name">Rudi Khoury</div><div class="role_company">Chief Digital Officer, Fisher & Paykel</div></div></blockquote></div></div></div></article></div></div></div></section></div>';
      


    
