//   }

// });


const utils = window.optimizely.get('utils');

utils.waitForElement('body').then(function() {

// 1. HTML for each customer blade (just swap logo/quote/name per customer)
var blades = {
    Fisher_Paykel: '<div data-blade-id="1779419772161_1b7e" data-blade-name="sf/nup" data-blade-position="1" data-blade-source="www" data-blade-type="blade" data-blade-variant="nup"><section class="layout--1 nup--blade nup--card_quote relative" id="1779419772161_1b7e"><div class="container container--min-spacing-bottom container--min-spacing-top"><div class="grid grid_main no-header nup nup__1"><div class="cards cards--minimal theme--light"><article class="card card__1 card__wrapper" data-module-id="1779419779113_9x3" data-module-name="Rudi Khoury" data-module-position="1" data-module-track-impressions="" data-module-type="card_quote"><div class="border-rad-16 card--card_quote flex pbc-g-elevation-2"><div class="card_quote_align--right"><div class="card__image__wrapper"><img alt="Fisher & Paykel logo" class="card__image" height="250" sizes="100vw" src="https://wp.sfdcdigital.com/en-au/wp-content/uploads/sites/12/2026/01/fisher-paykel.png?w=1024" srcset="https://wp.sfdcdigital.com/en-au/wp-content/uploads/sites/12/2026/01/fisher-paykel.png?resize=150,150 150w,https://wp.sfdcdigital.com/en-au/wp-content/uploads/sites/12/2026/01/fisher-paykel.png?resize=300,73 300w,https://wp.sfdcdigital.com/en-au/wp-content/uploads/sites/12/2026/01/fisher-paykel.png?resize=768,187 768w,https://wp.sfdcdigital.com/en-au/wp-content/uploads/sites/12/2026/01/fisher-paykel.png?resize=1024,250 1024w" width="1024"></div><div class="card__content__wrapper"><blockquote class="card__copy__wrapper"><div class="card__quote--au card__quote-mark" aria-hidden="true"></div><h3 class="card__headline">By connecting all our data, we can better understand customers\' needs and then use automation to reach out to them in real-time with the information or products they most want.</h3><div class="tagline_wrapper"><div class="name">Rudi Khoury</div><div class="role_company">Chief Digital Officer, Fisher & Paykel</div></div></blockquote></div></div></div></article></div></div></div></section></div>',
    Seek: '<div data-blade-id="1779420453600_13o" data-blade-position="2" data-blade-name="sf/nup" data-blade-variant="nup" data-blade-source="www" data-blade-type="blade"><section id="1779420453600_13o" class="relative nup--blade layout--1 nup--card_quote"><div class="container container--min-spacing-bottom container--min-spacing-top"><div class="grid grid_main nup nup__1 no-header"><div class="cards cards--minimal theme--light"><article class="card card__1 card__wrapper" data-module-track-impressions="" data-module-id="1779420453587_15di" data-module-name="Jamie Shen" data-module-position="1" data-module-type="card_quote"><div class="card--card_quote pbc-g-elevation-2 flex border-rad-16"><div class="card_quote_align--right"><div class="card__image__wrapper"><img src="https://wp.sfdcdigital.com/en-au/wp-content/uploads/sites/12/2026/01/seek.png" class="card__image" alt="SEEK logo" height="192" width="454"></div><div class="card__content__wrapper"><blockquote class="card__copy__wrapper"><div class="card__quote-mark card__quote--au" aria-hidden="true"></div><h3 class="card__headline">For the first time we have a holistic view of how customers are interacting across brands and countries and can collaborate to offer them solutions that meet their needs across Asia Pacific. We also have consistent business processes which enables new levels of efficiency.</h3><div class="tagline_wrapper"><div class="name">Jamie Shen</div><div class="role_company">Technology Delivery Lead, SEEK</div></div></blockquote></div></div></div></article></div></div></div></section></div>',
    EasyPark: '<div data-blade-id="1779420576745_9eb" data-blade-position="3" data-blade-name="sf/nup" data-blade-variant="nup" data-blade-source="www" data-blade-type="blade"><section id="1779420576745_9eb" class="relative nup--blade layout--1 nup--card_quote"><div class="container container--min-spacing-bottom container--min-spacing-top"><div class="grid grid_main nup nup__1 no-header"><div class="cards cards--minimal theme--light"><article class="card card__1 card__wrapper" data-module-track-impressions="" data-module-id="1779420576730_cu4" data-module-name="Jason Marks" data-module-position="1" data-module-type="card_quote"><div class="card--card_quote pbc-g-elevation-2 flex border-rad-16"><div class="card_quote_align--right"><div class="card__image__wrapper"><img src="https://wp.sfdcdigital.com/en-au/wp-content/uploads/sites/12/2026/04/easypark.jpg" class="card__image" alt="EasyPark logo" height="210" width="700"></div><div class="card__content__wrapper"><blockquote class="card__copy__wrapper"><div class="card__quote-mark card__quote--au" aria-hidden="true"></div><h3 class="card__headline">Salesforce plays a key role in helping us enhance the customer experience, so we can continue our mission of making cities more livable.</h3><div class="tagline_wrapper"><div class="name">Jason Marks</div><div class="role_company">General Manager, B2B, EasyPark ANZ</div></div></blockquote></div></div></div></article></div></div></div></section></div>',
    Pay: '<div data-blade-id="1779420746367_lg1" data-blade-position="4" data-blade-name="sf/nup" data-blade-variant="nup" data-blade-source="www" data-blade-type="blade"><section id="1779420746367_lg1" class="relative nup--blade layout--1 nup--card_quote"><div class="container container--min-spacing-bottom container--min-spacing-top"><div class="grid grid_main nup nup__1 no-header"><div class="cards cards--minimal theme--light"><article class="card card__1 card__wrapper" data-module-track-impressions="" data-module-id="1779420746354_l1p" data-module-name="David Walsh" data-module-position="1" data-module-type="card_quote"><div class="card--card_quote pbc-g-elevation-2 flex border-rad-16"><div class="card_quote_align--right"><div class="card__image__wrapper"><img loading="lazy" src="https://wp.sfdcdigital.com/en-au/wp-content/uploads/sites/12/2025/03/pay-com-au-logo.png" class="card__image" alt="Xero logo" height="36" width="180"></div><div class="card__content__wrapper"><blockquote class="card__copy__wrapper"><div class="card__quote-mark card__quote--au" aria-hidden="true"></div><h3 class="card__headline">With Agentforce deeply integrated into Salesforce and our ecosystem, we have a strong foundation which will make it easy for us to innovate.</h3><div class="tagline_wrapper"><div class="name">David Walsh</div><div class="role_company">Head of Digital, CX and Marketing, pay.com.au</div></div></blockquote></div></div></div></article></div></div></div></section></div>',
    Expert_Wealth: '<div data-blade-id="1779420797891_knl" data-blade-position="5" data-blade-name="sf/nup" data-blade-variant="nup" data-blade-source="www" data-blade-type="blade"><section id="1779420797891_knl" class="relative nup--blade layout--1 nup--card_quote"><div class="container container--min-spacing-bottom container--min-spacing-top"><div class="grid grid_main nup nup__1 no-header"><div class="cards cards--minimal theme--light"><article class="card card__1 card__wrapper" data-module-track-impressions="" data-module-id="1779420797874_k90" data-module-name="Paris Bisley" data-module-position="1" data-module-type="card_quote"><div class="card--card_quote pbc-g-elevation-2 flex border-rad-16"><div class="card_quote_align--right"><div class="card__image__wrapper"><img loading="lazy" src="https://wp.sfdcdigital.com/en-au/wp-content/uploads/sites/12/2025/06/expert-wealth-logo-01.webp?w=1024" class="card__image" alt="Expert Wealth logo" sizes="100vw" srcset="https://wp.sfdcdigital.com/en-au/wp-content/uploads/sites/12/2025/06/expert-wealth-logo-01.webp?resize=150, 150 150w, https://wp.sfdcdigital.com/en-au/wp-content/uploads/sites/12/2025/06/expert-wealth-logo-01.webp?resize=300, 73 300w, https://wp.sfdcdigital.com/en-au/wp-content/uploads/sites/12/2025/06/expert-wealth-logo-01.webp?resize=768, 187 768w, https://wp.sfdcdigital.com/en-au/wp-content/uploads/sites/12/2025/06/expert-wealth-logo-01.webp?resize=1024, 250 1024w" height="250" width="1024"></div><div class="card__content__wrapper"><blockquote class="card__copy__wrapper"><div class="card__quote-mark card__quote--au" aria-hidden="true"></div><h3 class="card__headline">Integrating Salesforce and Agentforce enables us to provide advice tailored to each client’s journey. By drawing live data from across their financial life—super, insurance, wealth, and property—we deliver timely insights that drive real progress.</h3><div class="tagline_wrapper"><div class="name">Paris Bisley</div><div class="role_company">Co-Founder and Financial Advisor, Expert Wealth</div></div></blockquote></div></div></div></article></div></div></div></section></div>'
};

// 2. Map each form's main blade ID → which customer blade to insert
var formToCustomer = {
    '1762451577906_xpo': 'Fisher_Paykel', // salesforce.com/au/agentforce/demos/overview/
    '1775683187835_170p':   'Fisher_Paykel', // salesforce.com/au/agentforce/resources/maximizing-roi-with-agentforce 
    '1765829385232_8r7':   'Fisher_Paykel', // salesforce.com/au/marketing/resources/marketing-platform-and-martech
    '1762876826649_w9v':   'Fisher_Paykel', // salesforce.com/au/marketing/demos/crm-overview
    '1773668427815_kk6':   'Fisher_Paykel', // salesforce.com/au/data/demos/data-cloud
    '1762812571028_tdw':   'Fisher_Paykel', // salesforce.com/au/service/demos/crm-overview
    '1775044654130_bwu':   'Fisher_Paykel', // salesforce.com/au/marketing/demos/marketing-cloud
    '1762812571028_tdw':   'Fisher_Paykel', // salesforce.com/au/service/demos/field-service-demo
    '1774912924189_113e':   'Seek', // salesforce.com/au/sales/demos/crm-overview
    '1774898293627_ff9':  'EasyPark', // salesforce.com/au/sales/demos/agentforce-sales-demos
    '1775493173033_1062':  'EasyPark', // salesforce.com/au/sales/demos/ai
    '1762869534624_1dxj':  'Pay', // salesforce.com/au/small-business/demos/smb-overview
    '1762882881706_nc0':  'Expert_Wealth' // salesforce.com/au/financial-services/demos/agentforce-for-finserv
};

// 3. Loop through the mapping, insert the right blade after each form
Object.keys(formToCustomer).forEach(function(formId) {
    // 3a. Find the form on the page (skip if not present on this page)
    var mainForm = document.querySelector('div[data-blade-id="' + formId + '"]');
    if (!mainForm) return; // form not on this page — skip silently

    // 3b. Insert the matching customer blade right after the form
    var customerKey = formToCustomer[formId];
    var newBlade = blades[customerKey];
    mainForm.insertAdjacentHTML('afterend', newBlade);

    // 3c. Grab the blade we just inserted so we can style it
    var insertedBlade = mainForm.nextElementSibling;

    // 3d. Add spacing between the new blade and the footer (40-60px range)
    insertedBlade.style.marginBottom = '50px';

    // 3e. Shrink the font sizes inside the new blade ONLY FOR Seek & Expert Wealth - adjust these values based on what you see in the 'Computed' tab after inspective element
    if (customerKey === 'Seek' || customerKey === 'Expert_Wealth') {
        var headline = insertedBlade.querySelector('.card__headline');
        var name     = insertedBlade.querySelector('.name');
        var role     = insertedBlade.querySelector('.role_company');

        if (headline) headline.style.fontSize = '16px'; // kept same as original, no changes
        if (name)     name.style.fontSize     = '16px'; // kept same as original, no changes
        if (role)     role.style.fontSize     = '16px'; // kept same as original, no changes

    }
    // // Add spacing between the new blade and the footer
    // mainForm.nextElementSibling.style.marginBottom = '50px';
});

